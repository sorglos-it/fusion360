apps/firmware*/include/config.h

# Fremdcode per Paketmanager
apps/*/vendor/

# Protokolle der Editor-Hooks, keine Projektinhalte
receipts/
review-receipts/

# Betriebssystem und Editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
.venv/

# SYSTEM 3E Herstellerdateien - nur lokal, nie ins Repo
assets/system3e/*
!assets/system3e/.gitkeep

# Wissensgraph von graphify - erzeugt, nicht Teil des Projekts
graphify-out/
